{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCP-GHOST",
  "version": "5.3.0",
  "identifier": "io.cocoon.scpghost",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SCP-GHOST",
        "width": 660,
        "height": 880,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Cocoon",
    "copyright": "© 2026 Cocoon",
    "category": "Utility",
    "shortDescription": "SCP-GHOST tunnel client (mihomo-compatible core)",
    "longDescription": "Desktop controller for the SCP-GHOST tunnel. Ships the meow proxy core (mihomo-compatible, Rust) as a sidecar and drives it with a config built from the VLESS subscription.",
    "externalBin": ["binaries/meow"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
