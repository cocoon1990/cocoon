{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCP-GHOST",
  "version": "5.2.6",
  "identifier": "io.cocoon.scpghost",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SCP-GHOST",
        "width": 620,
        "height": 840,
        "minWidth": 460,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Cocoon",
    "copyright": "© 2025 Cocoon",
    "category": "Utility",
    "shortDescription": "SCP-GHOST tunnel client",
    "longDescription": "Desktop companion for the SCP-GHOST tunnel: X25519 session handshake and HMAC-signed streaming requests.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
