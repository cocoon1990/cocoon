{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCP-GHOST",
  "version": "5.4.0",
  "identifier": "io.cocoon.scpghost",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SCP-GHOST",
        "width": 640,
        "height": 900,
        "minWidth": 520,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Cocoon",
    "copyright": "© 2026 Cocoon",
    "category": "utility",
    "shortDescription": "SCP-GHOST — invisible-in-invisible VLESS tunnel",
    "longDescription": "SCP-GHOST is a desktop shell for the Cocoon-in-Cocoon VLESS tunnel. The UI is a controller; all networking runs in the bundled meow core.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/meow"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/cocoon1990/cocoon/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
