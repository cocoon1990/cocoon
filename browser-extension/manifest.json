{
  "manifest_version": 3,
  "name": "SCP-GHOST — Phantom Companion",
  "version": "5.2.6",
  "description": "Companion client for the SCP-GHOST streaming worker: X25519 session + HMAC-signed requests.",
  "minimum_chrome_version": "116",

  "permissions": [
    "storage",
    "tabs",
    "proxy",
    "declarativeNetRequest"
  ],

  "host_permissions": [
    "https://ghost-signaling-worker.cocoon-de9.workers.dev/*",
    "https://ghost-streaming-worker.cocoon-de9.workers.dev/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "SCP-GHOST"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
